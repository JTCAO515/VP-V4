# Local development probe only. Inject keys securely; never commit values.
AMAP_PROBE_ENABLED=false
AMAP_WEB_SERVICE_KEY=
TENCENT_MAP_PROBE_ENABLED=false
TENCENT_MAP_WEB_SERVICE_KEY=
# Only needed if the Tencent key has WebService "签名校验/SN校验" enabled in
# the console. Leave blank if the key does not require request signing.
TENCENT_MAP_SK=
# Per-capability flags for lib/server/maps/*-adapter.ts — each capability is
# explicitly enabled on its own (no implicit "provider enabled means every
# capability enabled"), reusing the same account key/sk above.
AMAP_SEARCH_ENABLED=false
TENCENT_MAP_SEARCH_ENABLED=false
AMAP_DETAIL_ENABLED=false
TENCENT_MAP_DETAIL_ENABLED=false
AMAP_GEOCODE_ENABLED=false
TENCENT_MAP_GEOCODE_ENABLED=false
AMAP_SUGGEST_ENABLED=false
TENCENT_MAP_SUGGEST_ENABLED=false
AMAP_NEARBY_ENABLED=false
TENCENT_MAP_NEARBY_ENABLED=false
# Reverse geocoding is an address observation only. Keep disabled until the
# account's Web Service key and permitted coordinate-data use are verified.
AMAP_REVERSE_GEOCODE_ENABLED=false
