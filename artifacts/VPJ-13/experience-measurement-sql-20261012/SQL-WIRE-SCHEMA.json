{
  "schemaVersion": "journey-experience-measurement/1",
  "kind": "PRIVATE_TYPED_SOURCE_PROJECTION",
  "sourceRows": [
    "consents",
    "admissions",
    "reports",
    "erasureReceipts",
    "recoveryControls",
    "journals",
    "copyObligations"
  ],
  "projection": [
    {
      "group": "consents",
      "relation": "journey_measurement_private.consents_v1",
      "columns": [
        {
          "name": "owner_id",
          "type": "uuid",
          "notNull": true
        },
        {
          "name": "consent_id",
          "type": "uuid",
          "notNull": true
        },
        {
          "name": "operation_id",
          "type": "uuid",
          "notNull": true
        },
        {
          "name": "request_metadata_digest",
          "type": "text",
          "notNull": true
        },
        {
          "name": "session_id",
          "type": "uuid",
          "notNull": true
        },
        {
          "name": "mobile_epoch",
          "type": "bigint",
          "notNull": true
        },
        {
          "name": "notice_version",
          "type": "text",
          "notNull": true
        },
        {
          "name": "entries",
          "type": "text[]",
          "notNull": true
        },
        {
          "name": "accepted_at",
          "type": "timestamp with time zone",
          "notNull": true
        },
        {
          "name": "expires_at",
          "type": "timestamp with time zone",
          "notNull": true
        },
        {
          "name": "revoked_at",
          "type": "timestamp with time zone",
          "notNull": false
        }
      ],
      "constraints": [
        [
          "consents_v1_check",
          "CHECK ((expires_at = (accepted_at + '30 days'::interval)))"
        ],
        [
          "consents_v1_check1",
          "CHECK (((revoked_at IS NULL) OR (revoked_at >= accepted_at)))"
        ],
        [
          "consents_v1_consent_id_key",
          "UNIQUE (consent_id)"
        ],
        [
          "consents_v1_entries_check",
          "CHECK ((((cardinality(entries) >= 1) AND (cardinality(entries) <= 3)) AND (entries <@ ARRAY['e1'::text, 'e2'::text, 'e3'::text])))"
        ],
        [
          "consents_v1_mobile_epoch_check",
          "CHECK (((mobile_epoch >= 1) AND (mobile_epoch <= '9007199254740991'::bigint)))"
        ],
        [
          "consents_v1_notice_version_check",
          "CHECK ((notice_version = 'journey-experience-measurement/2026-10-12'::text))"
        ],
        [
          "consents_v1_owner_id_fkey",
          "FOREIGN KEY (owner_id) REFERENCES auth.users(id) ON DELETE CASCADE"
        ],
        [
          "consents_v1_pkey",
          "PRIMARY KEY (owner_id)"
        ],
        [
          "consents_v1_request_metadata_digest_check",
          "CHECK ((request_metadata_digest ~ '^[a-f0-9]{64}$'::text))"
        ]
      ],
      "rls": true,
      "acl": "{postgres=arwdDxtm/postgres}"
    },
    {
      "group": "admissions",
      "relation": "journey_measurement_private.admissions_v1",
      "columns": [
        {
          "name": "owner_id",
          "type": "uuid",
          "notNull": true
        },
        {
          "name": "admission_id",
          "type": "uuid",
          "notNull": true
        },
        {
          "name": "request_metadata_digest",
          "type": "text",
          "notNull": true
        },
        {
          "name": "consent_id",
          "type": "uuid",
          "notNull": true
        },
        {
          "name": "entry",
          "type": "text",
          "notNull": true
        },
        {
          "name": "source_kind",
          "type": "text",
          "notNull": true
        },
        {
          "name": "source_id",
          "type": "uuid",
          "notNull": true
        },
        {
          "name": "source_revision",
          "type": "integer",
          "notNull": false
        },
        {
          "name": "source_ref",
          "type": "jsonb",
          "notNull": true
        },
        {
          "name": "clock_origin",
          "type": "jsonb",
          "notNull": true
        },
        {
          "name": "task_id",
          "type": "uuid",
          "notNull": false
        },
        {
          "name": "goal_id",
          "type": "uuid",
          "notNull": false
        },
        {
          "name": "accepted_at",
          "type": "timestamp with time zone",
          "notNull": false
        },
        {
          "name": "received_at",
          "type": "timestamp with time zone",
          "notNull": true
        },
        {
          "name": "expires_at",
          "type": "timestamp with time zone",
          "notNull": true
        },
        {
          "name": "session_id",
          "type": "uuid",
          "notNull": true
        },
        {
          "name": "mobile_epoch",
          "type": "bigint",
          "notNull": true
        },
        {
          "name": "first_ever",
          "type": "text",
          "notNull": true
        }
      ],
      "constraints": [
        [
          "admissions_v1_check",
          "CHECK ((expires_at = (received_at + '30 days'::interval)))"
        ],
        [
          "admissions_v1_check1",
          "CHECK ((accepted_at <= received_at))"
        ],
        [
          "admissions_v1_check2",
          "CHECK ((((source_kind = 'service_task'::text) AND (task_id = source_id) AND (source_revision IS NULL)) OR ((source_kind = 'native_entry'::text) AND (accepted_at IS NULL))))"
        ],
        [
          "admissions_v1_consent_id_fkey",
          "FOREIGN KEY (consent_id) REFERENCES journey_measurement_private.consents_v1(consent_id) ON DELETE CASCADE"
        ],
        [
          "admissions_v1_entry_check",
          "CHECK ((entry = ANY (ARRAY['e1'::text, 'e2'::text, 'e3'::text])))"
        ],
        [
          "admissions_v1_first_ever_check",
          "CHECK ((first_ever = ANY (ARRAY['proven'::text, 'unknown'::text])))"
        ],
        [
          "admissions_v1_goal_id_fkey",
          "FOREIGN KEY (goal_id) REFERENCES turn_private.assistant_goals(id) ON DELETE CASCADE"
        ],
        [
          "admissions_v1_owner_id_consent_id_entry_source_kind_source__key",
          "UNIQUE (owner_id, consent_id, entry, source_kind, source_id, source_ref)"
        ],
        [
          "admissions_v1_owner_id_fkey",
          "FOREIGN KEY (owner_id) REFERENCES auth.users(id) ON DELETE CASCADE"
        ],
        [
          "admissions_v1_pkey",
          "PRIMARY KEY (owner_id, admission_id)"
        ],
        [
          "admissions_v1_request_metadata_digest_check",
          "CHECK ((request_metadata_digest ~ '^[a-f0-9]{64}$'::text))"
        ],
        [
          "admissions_v1_source_kind_check",
          "CHECK ((source_kind = ANY (ARRAY['service_task'::text, 'native_entry'::text])))"
        ],
        [
          "admissions_v1_task_id_fkey",
          "FOREIGN KEY (task_id) REFERENCES turn_private.service_tasks(id) ON DELETE CASCADE"
        ]
      ],
      "rls": true,
      "acl": "{postgres=arwdDxtm/postgres}"
    },
    {
      "group": "reports",
      "relation": "journey_measurement_private.reports_v1",
      "columns": [
        {
          "name": "owner_id",
          "type": "uuid",
          "notNull": true
        },
        {
          "name": "report_id",
          "type": "uuid",
          "notNull": true
        },
        {
          "name": "request_metadata_digest",
          "type": "text",
          "notNull": true
        },
        {
          "name": "admission_id",
          "type": "uuid",
          "notNull": true
        },
        {
          "name": "signal",
          "type": "jsonb",
          "notNull": true
        },
        {
          "name": "clock",
          "type": "jsonb",
          "notNull": true
        },
        {
          "name": "received_at",
          "type": "timestamp with time zone",
          "notNull": true
        },
        {
          "name": "expires_at",
          "type": "timestamp with time zone",
          "notNull": true
        }
      ],
      "constraints": [
        [
          "measurement_clock_closed_v1",
          "CHECK ((journey_measurement_private.clock_shape_v1(clock) IS TRUE))"
        ],
        [
          "measurement_signal_closed_v1",
          "CHECK ((journey_measurement_private.signal_shape_v1(signal) IS TRUE))"
        ],
        [
          "reports_v1_check",
          "CHECK ((expires_at <= (received_at + '30 days'::interval)))"
        ],
        [
          "reports_v1_clock_check",
          "CHECK (((jsonb_typeof(clock) = 'object'::text) AND (octet_length((clock)::text) <= 256)))"
        ],
        [
          "reports_v1_owner_id_admission_id_fkey",
          "FOREIGN KEY (owner_id, admission_id) REFERENCES journey_measurement_private.admissions_v1(owner_id, admission_id) ON DELETE CASCADE"
        ],
        [
          "reports_v1_pkey",
          "PRIMARY KEY (owner_id, report_id)"
        ],
        [
          "reports_v1_request_metadata_digest_check",
          "CHECK ((request_metadata_digest ~ '^[a-f0-9]{64}$'::text))"
        ],
        [
          "reports_v1_signal_check",
          "CHECK (((jsonb_typeof(signal) = 'object'::text) AND (octet_length((signal)::text) <= 2048)))"
        ]
      ],
      "rls": true,
      "acl": "{postgres=arwdDxtm/postgres}"
    },
    {
      "group": "erasureReceipts",
      "relation": "journey_measurement_private.erasure_receipts_v1",
      "columns": [
        {
          "name": "owner_id",
          "type": "uuid",
          "notNull": true
        },
        {
          "name": "operation_id",
          "type": "uuid",
          "notNull": true
        },
        {
          "name": "consent_id",
          "type": "uuid",
          "notNull": false
        },
        {
          "name": "state",
          "type": "text",
          "notNull": true
        },
        {
          "name": "source_digest",
          "type": "text",
          "notNull": false
        },
        {
          "name": "preview_digest",
          "type": "text",
          "notNull": false
        },
        {
          "name": "request_metadata_digest",
          "type": "text",
          "notNull": false
        },
        {
          "name": "erased_rows",
          "type": "integer",
          "notNull": true
        },
        {
          "name": "decided_at",
          "type": "timestamp with time zone",
          "notNull": true
        },
        {
          "name": "expires_at",
          "type": "timestamp with time zone",
          "notNull": true
        }
      ],
      "constraints": [
        [
          "erasure_receipts_v1_check",
          "CHECK ((expires_at = (decided_at + '30 days'::interval)))"
        ],
        [
          "erasure_receipts_v1_erased_rows_check",
          "CHECK (((erased_rows >= 0) AND (erased_rows <= 10000)))"
        ],
        [
          "erasure_receipts_v1_owner_id_fkey",
          "FOREIGN KEY (owner_id) REFERENCES auth.users(id) ON DELETE CASCADE"
        ],
        [
          "erasure_receipts_v1_pkey",
          "PRIMARY KEY (owner_id, operation_id)"
        ],
        [
          "erasure_receipts_v1_state_check",
          "CHECK ((state = ANY (ARRAY['preview'::text, 'incomplete'::text, 'erased'::text])))"
        ]
      ],
      "rls": true,
      "acl": "{postgres=arwdDxtm/postgres}"
    },
    {
      "group": "recoveryControls",
      "relation": "journey_measurement_private.recovery_controls_v1",
      "columns": [
        {
          "name": "owner_id",
          "type": "uuid",
          "notNull": true
        },
        {
          "name": "control_id",
          "type": "uuid",
          "notNull": true
        },
        {
          "name": "reconciliation_generation",
          "type": "bigint",
          "notNull": true
        },
        {
          "name": "erasure_floor",
          "type": "bigint",
          "notNull": true
        },
        {
          "name": "covered_from_at",
          "type": "timestamp with time zone",
          "notNull": true
        },
        {
          "name": "covered_through_at",
          "type": "timestamp with time zone",
          "notNull": true
        },
        {
          "name": "coverage_complete",
          "type": "boolean",
          "notNull": true
        },
        {
          "name": "authority_received_at",
          "type": "timestamp with time zone",
          "notNull": true
        },
        {
          "name": "expires_at",
          "type": "timestamp with time zone",
          "notNull": true
        }
      ],
      "constraints": [
        [
          "recovery_controls_v1_check",
          "CHECK ((covered_from_at <= covered_through_at))"
        ],
        [
          "recovery_controls_v1_check1",
          "CHECK ((expires_at <= (authority_received_at + '30 days'::interval)))"
        ],
        [
          "recovery_controls_v1_control_id_key",
          "UNIQUE (control_id)"
        ],
        [
          "recovery_controls_v1_erasure_floor_check",
          "CHECK (((erasure_floor >= 0) AND (erasure_floor <= '9007199254740991'::bigint)))"
        ],
        [
          "recovery_controls_v1_owner_id_fkey",
          "FOREIGN KEY (owner_id) REFERENCES auth.users(id) ON DELETE CASCADE"
        ],
        [
          "recovery_controls_v1_pkey",
          "PRIMARY KEY (owner_id)"
        ],
        [
          "recovery_controls_v1_reconciliation_generation_check",
          "CHECK (((reconciliation_generation >= 1) AND (reconciliation_generation <= '9007199254740991'::bigint)))"
        ]
      ],
      "rls": true,
      "acl": "{postgres=arwdDxtm/postgres}"
    },
    {
      "group": "journals",
      "relation": "journey_measurement_private.journals_v1",
      "columns": [
        {
          "name": "owner_id",
          "type": "uuid",
          "notNull": true
        },
        {
          "name": "journal_id",
          "type": "uuid",
          "notNull": true
        },
        {
          "name": "event_kind",
          "type": "text",
          "notNull": true
        },
        {
          "name": "authority_id",
          "type": "uuid",
          "notNull": true
        },
        {
          "name": "floor",
          "type": "bigint",
          "notNull": true
        },
        {
          "name": "authority_received_at",
          "type": "timestamp with time zone",
          "notNull": true
        },
        {
          "name": "expires_at",
          "type": "timestamp with time zone",
          "notNull": true
        }
      ],
      "constraints": [
        [
          "journals_v1_check",
          "CHECK ((expires_at <= (authority_received_at + '30 days'::interval)))"
        ],
        [
          "journals_v1_event_kind_check",
          "CHECK ((event_kind = ANY (ARRAY['withdrawal'::text, 'erasure'::text, 'source_expiry'::text, 'copy_obligation'::text, 'copy_ack'::text])))"
        ],
        [
          "journals_v1_floor_check",
          "CHECK (((floor >= 0) AND (floor <= '9007199254740991'::bigint)))"
        ],
        [
          "journals_v1_owner_id_event_kind_authority_id_key",
          "UNIQUE (owner_id, event_kind, authority_id)"
        ],
        [
          "journals_v1_owner_id_fkey",
          "FOREIGN KEY (owner_id) REFERENCES auth.users(id) ON DELETE CASCADE"
        ],
        [
          "journals_v1_pkey",
          "PRIMARY KEY (owner_id, journal_id)"
        ]
      ],
      "rls": true,
      "acl": "{postgres=arwdDxtm/postgres}"
    },
    {
      "group": "copyObligations",
      "relation": "journey_measurement_private.copy_obligations_v1",
      "columns": [
        {
          "name": "owner_id",
          "type": "uuid",
          "notNull": true
        },
        {
          "name": "copy_id",
          "type": "uuid",
          "notNull": true
        },
        {
          "name": "generation",
          "type": "integer",
          "notNull": true
        },
        {
          "name": "kind",
          "type": "text",
          "notNull": true
        },
        {
          "name": "core_request_id",
          "type": "uuid",
          "notNull": false
        },
        {
          "name": "source_digest",
          "type": "text",
          "notNull": true
        },
        {
          "name": "state",
          "type": "text",
          "notNull": true
        },
        {
          "name": "received_at",
          "type": "timestamp with time zone",
          "notNull": true
        },
        {
          "name": "expires_at",
          "type": "timestamp with time zone",
          "notNull": true
        }
      ],
      "constraints": [
        [
          "copy_obligations_v1_check",
          "CHECK ((expires_at <= (received_at + '30 days'::interval)))"
        ],
        [
          "copy_obligations_v1_check1",
          "CHECK ((((kind = 'core_export'::text) AND (core_request_id = copy_id)) OR ((kind <> 'core_export'::text) AND (core_request_id IS NULL))))"
        ],
        [
          "copy_obligations_v1_generation_check",
          "CHECK (((generation >= 1) AND (generation <= 3)))"
        ],
        [
          "copy_obligations_v1_kind_check",
          "CHECK ((kind = ANY (ARRAY['core_export'::text, 'independent_journal'::text, 'external_download'::text])))"
        ],
        [
          "copy_obligations_v1_owner_id_fkey",
          "FOREIGN KEY (owner_id) REFERENCES auth.users(id) ON DELETE CASCADE"
        ],
        [
          "copy_obligations_v1_pkey",
          "PRIMARY KEY (owner_id, copy_id, generation)"
        ],
        [
          "copy_obligations_v1_source_digest_check",
          "CHECK ((source_digest ~ '^[a-f0-9]{64}$'::text))"
        ],
        [
          "copy_obligations_v1_state_check",
          "CHECK ((state = ANY (ARRAY['pending'::text, 'erased'::text, 'unknown'::text])))"
        ]
      ],
      "rls": true,
      "acl": "{postgres=arwdDxtm/postgres}"
    }
  ],
  "copyProjection": "Per original Core request excludes that request copy_id and linked own journals only; no other copy omitted",
  "defaultCollection": "DENIED",
  "wholeLifecycle": "INCOMPLETE",
  "erasureWire": "requestDigest/decidedAt/expiresAt/lifecycle exact; source payload erased may coexist with copy unknown/incomplete"
}
