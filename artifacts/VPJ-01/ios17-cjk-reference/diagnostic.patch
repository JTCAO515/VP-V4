+// Temporary reference screen, removed after the diagnostic.
+struct CJKReferenceView: View {
+    let useUIKit: Bool
+    var body: some View {
+        VStack {
+            Spacer()
+            if useUIKit {
+                CJKReferenceLabel().frame(width: 333)
+            } else {
+                Text("preview.message").font(.footnote)
+                    .foregroundStyle(Color.vpSecondaryText)
+                    .fixedSize(horizontal: false, vertical: true)
+                    .frame(width: 333, alignment: .leading)
+                    .accessibilityIdentifier("cjk-reference")
+            }
+            Spacer()
+        }
+        .frame(maxWidth: .infinity, maxHeight: .infinity)
+        .background(Color.vpBackground)
+    }
+}
+struct CJKReferenceLabel: UIViewRepresentable {
+    func makeUIView(context: Context) -> UILabel {
+        let label = UILabel()
+        label.numberOfLines = 0
+        label.adjustsFontForContentSizeCategory = true
+        label.textColor = UIColor(white: 0.30, alpha: 1)
+        label.accessibilityIdentifier = "cjk-reference"
+        return label
+    }
+    func updateUIView(_ label: UILabel, context: Context) {
+        label.text = "此版本尚未连接实时数据、账号、AI、预订或支付。"
+        label.font = UIFont.preferredFont(forTextStyle: .footnote)
+        print("[CJK-REFERENCE] UIKit font=\(label.font.pointSize) category=\(label.traitCollection.preferredContentSizeCategory.rawValue)")
+    }
+    func sizeThatFits(_ proposal: ProposedViewSize, uiView: UILabel, context: Context) -> CGSize? {
+        let width = proposal.width ?? 333
+        return CGSize(width: width, height: uiView.sizeThatFits(CGSize(width: width, height: .greatestFiniteMagnitude)).height)
+    }
+}
