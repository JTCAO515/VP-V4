+    func testCJKReferenceAudit() throws {
+        continueAfterFailure = true
+        for mode in ["production", "swiftui", "uikit"] {
+            for largest in [false, true] {
+                let app = XCUIApplication()
+                app.launchArguments = ["-VisePandaLocale", "zh-Hans", "-AppleLanguages", "(zh-Hans)", "-AppleLocale", "zh_CN", "-CJKProbe", "-UIPreferredContentSizeCategoryName", largest ? "UICTContentSizeCategoryAccessibilityXXXL" : "UICTContentSizeCategoryL"]
+                if mode == "swiftui" { app.launchArguments.append("-CJKSwiftUI") }
+                if mode == "uikit" { app.launchArguments.append("-CJKUIKit") }
+                app.launch()
+                let message = mode == "production" ? app.staticTexts["此版本尚未连接实时数据、账号、AI、预订或支付。"] : app.staticTexts["cjk-reference"]
+                XCTAssertTrue(message.waitForExistence(timeout: 5))
+                if mode == "production" {
+                    let scroll = app.scrollViews.firstMatch
+                    for _ in 0..<12 {
+                        let top = app.navigationBars.firstMatch.frame.maxY + 8
+                        let bottom = app.otherElements["ask-composer"].frame.minY - 8
+                        let delta = message.frame.maxY > bottom ? min(message.frame.maxY - bottom + 8, 160) : message.frame.minY < top ? -min(top - message.frame.minY + 8, 160) : 0
+                        if delta == 0 { break }
+                        let start = scroll.coordinate(withNormalizedOffset: CGVector(dx: 0.5, dy: 0.5))
+                        start.press(forDuration: 0.05, thenDragTo: start.withOffset(CGVector(dx: 0, dy: -delta)), withVelocity: .slow, thenHoldForDuration: 0.1)
+                    }
+                }
+                print("[CJK-REFERENCE] mode=\(mode) largest=\(largest) frame=\(message.frame) label=\(message.label)")
+                capture("CJK-\(mode)-\(largest ? "largest" : "normal")", app: app)
+                let clipped = XCTAttachment(screenshot: message.screenshot()); clipped.name = "CJK-element-\(mode)-\(largest ? "largest" : "normal")"; clipped.lifetime = .keepAlways; add(clipped)
+                print("[CJK-REFERENCE] audit begin \(mode) largest=\(largest)")
+                try app.performAccessibilityAudit { issue in
+                    print("[CJK-REFERENCE] issue mode=\(mode) largest=\(largest) type=\(issue.auditType.rawValue) detail=\(issue.detailedDescription) element=\(String(describing: issue.element))")
+                    return false
+                }
+                print("[CJK-REFERENCE] audit end \(mode) largest=\(largest)")
+                app.terminate()
+            }
+        }
+    }
+
