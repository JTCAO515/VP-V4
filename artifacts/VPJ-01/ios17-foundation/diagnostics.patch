+    func testChineseAuditWithAndWithoutTextOverride() throws {
+        continueAfterFailure = true
+        let previousAppearance = XCUIDevice.shared.appearance
+        XCUIDevice.shared.appearance = .light
+        defer { XCUIDevice.shared.appearance = previousAppearance }
+        for fixedOverride in [true, false] {
+            let app = XCUIApplication()
+            app.launchArguments = ["-VisePandaLocale", "zh-Hans", "-AppleLanguages", "(zh-Hans)", "-AppleLocale", "zh_CN"]
+            if fixedOverride { app.launchArguments += ["-UIPreferredContentSizeCategoryName", "UICTContentSizeCategoryL"] }
+            app.launch()
+            capture("Chinese-before-audit-fixed-\(fixedOverride)", app: app)
+            print("[AX-DIAG] begin fixedOverride=\(fixedOverride)")
+            try app.performAccessibilityAudit { issue in
+                print("[AX-DIAG] fixed=\(fixedOverride) type=\(issue.auditType.rawValue) detail=\(issue.detailedDescription) element=\(String(describing: issue.element))")
+                return false
+            }
+            print("[AX-DIAG] end fixedOverride=\(fixedOverride)")
+            capture("Chinese-after-audit-fixed-\(fixedOverride)", app: app)
+            app.terminate()
+        }
+    }
