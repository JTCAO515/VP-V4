+    @objc func testEnglishAskViewportEvidence() throws {
+        let previousAppearance = XCUIDevice.shared.appearance
+        XCUIDevice.shared.appearance = .light
+        defer { XCUIDevice.shared.appearance = previousAppearance }
+        let app = launch()
+        let scroll = app.scrollViews.firstMatch
+        let composer = app.otherElements["ask-composer"]
+        var fullyVisibleLabels = Set<String>()
+        func recordVisibleText() {
+            let top = app.navigationBars.firstMatch.frame.maxY
+            let bottom = composer.frame.minY
+            for text in scroll.staticTexts.allElementsBoundByIndex {
+                let frame = text.frame
+                if frame.minY >= top && frame.maxY <= bottom {
+                    fullyVisibleLabels.insert(text.label)
+                    print("Ask complete text: \(text.label); frame \(frame), viewport \(top)...\(bottom)")
+                }
+            }
+        }
+        recordVisibleText()
+        capture("Ask-English-initial-text-coverage", app: app)
+        for index in 0..<8 {
+            let top = app.navigationBars.firstMatch.frame.maxY
+            let bottom = composer.frame.minY
+            let clipped = scroll.staticTexts.allElementsBoundByIndex.map(\.frame).filter {
+                ($0.minY < top && $0.maxY > top) || ($0.minY < bottom && $0.maxY > bottom)
+            }
+            print("Ask viewport gap attempt \(index), clipped frames: \(clipped)")
+            if clipped.isEmpty { break }
+            let distance = clipped.map { $0.minY < top ? $0.maxY - top + 8 : $0.maxY - bottom + 8 }.max() ?? 0
+            let start = scroll.coordinate(withNormalizedOffset: CGVector(dx: 0.5, dy: 0.5))
+            let end = start.withOffset(CGVector(dx: 0, dy: -min(distance, 180)))
+            start.press(forDuration: 0.05, thenDragTo: end, withVelocity: .slow, thenHoldForDuration: 0.2)
+            recordVisibleText()
+        }
+        let finalPrompt = app.buttons["What should I prepare before arrival?"]
+        assertFullyVisible(finalPrompt, in: app)
+        recordVisibleText()
+        print("Ask complete text coverage: \(fullyVisibleLabels.sorted())")
+        capture("Ask-English-gap-before-audit", app: app)
+        let top = app.navigationBars.firstMatch.frame.maxY
+        let bottom = composer.frame.minY
+        for text in scroll.staticTexts.allElementsBoundByIndex {
+            let frame = text.frame
+            XCTAssertFalse(frame.minY < top && frame.maxY > top, "Top boundary crosses \(text.label): \(frame)")
+            XCTAssertFalse(frame.minY < bottom && frame.maxY > bottom, "Bottom boundary crosses \(text.label): \(frame)")
+        }
+        try app.performAccessibilityAudit { issue in
+            print("Ask viewport AX issue: \(issue.compactDescription), element: \(String(describing: issue.element))")
+            return false
+        }
+    }
