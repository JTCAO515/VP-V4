+        case .unknown: notice = "CANONICAL_PLACE_RECOVERY_REQUIRED"
+        case .notSubmitted: notice = "CANONICAL_PLACE_NOT_SUBMITTED"
+        case .unavailable(let reason): notice = "CANONICAL_PLACE_" + reason
+        }
+    }
