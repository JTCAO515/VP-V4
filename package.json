{
  "name": "vp-v4",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm generate:design-tokens && next dev --webpack",
    "build": "pnpm generate:design-tokens && next build --webpack",
    "start": "next start",
    "lint": "node scripts/lint.mjs",
    "generate:design-tokens": "node scripts/generate-design-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/static-output.test.mjs tests/design/web-06-foundation.test.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "test:unit": "node scripts/run-ci-suite.mjs unit",
    "test:contract": "node scripts/run-ci-suite.mjs contract",
    "test:integration": "node scripts/run-ci-suite.mjs integration",
    "test:security": "node scripts/run-ci-suite.mjs security",
    "test:e2e": "node scripts/run-ci-suite.mjs e2e",
    "evals": "node scripts/run-ci-suite.mjs evals",
    "db:verify": "node scripts/db-verify.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "check:flags": "node --experimental-strip-types scripts/check-flags.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:assets:release": "node scripts/check-assets.mjs --release"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "postcss": "8.5.26",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "enhanced-resolve": "5.24.2"
    }
  }
}
