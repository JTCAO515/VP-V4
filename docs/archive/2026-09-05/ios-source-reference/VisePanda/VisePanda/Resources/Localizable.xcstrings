    "today.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your next step, useful tools, and trip context will meet here when services are ready."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务就绪后，下一步、实用工具和行程上下文将在这里汇合。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando los servicios estén listos, aquí se reunirán tu próximo paso, las herramientas y el contexto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда сервисы будут готовы, здесь появятся следующий шаг, инструменты и контекст поездки."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما تصبح الخدمات جاهزة ستجتمع هنا خطوتك التالية والأدوات وسياق الرحلة."
          }
        }
      }
    },
