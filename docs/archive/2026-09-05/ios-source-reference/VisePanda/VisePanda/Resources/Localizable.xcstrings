    "preview.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live data, accounts, AI, booking, and payments are not connected in this version."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本尚未连接实时数据、账号、AI、预订或支付。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión aún no conecta datos en vivo, cuentas, IA, reservas ni pagos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой версии не подключены актуальные данные, аккаунты, ИИ, бронирование и оплата."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتصل هذه النسخة بالبيانات المباشرة أو الحسابات أو الذكاء الاصطناعي أو الحجز أو الدفع."
          }
        }
      }
    },
